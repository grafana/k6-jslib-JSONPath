# This project's dev toolchain predates npm 7's strict peer-dependency
# resolution: eslint-config-ash-nazg@6 declares a peer on
# eslint-plugin-unicorn@^8, while the root project uses ^9. npm 6 tolerated
# this; npm >=7 fails `npm install` with ERESOLVE. Preserve the original
# (npm 6) resolution behaviour so the lockfile can be regenerated.
legacy-peer-deps=true
